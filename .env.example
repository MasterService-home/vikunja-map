# Copy to .env and fill in. Do NOT commit .env (it holds the token).

# Base URL of your Vikunja instance, reachable from wherever this runs.
# "/api/v1" is appended automatically if missing.
VIKUNJA_URL=https://vikunja.example.com

# Vikunja API token (Settings > API Tokens). A READ-ONLY token is enough.
VIKUNJA_TOKEN=put-your-token-here

# Cache in seconds: 0 = regenerate on every refresh (always fresh).
# Raise to 30-60 to protect Vikunja from very frequent refreshes.
CACHE_TTL=0
